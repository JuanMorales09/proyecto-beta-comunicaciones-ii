    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: S2_QPSK_CW_interferente
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
