options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Escenario S2: QPSK + AWGN + interferente CW estrecho (Grupo 5)'
